{
    "name": "react-meta-seo",
    "version": "0.1.0",
    "description": "The definitive SEO library for React 19. Zero-runtime overhead, compatible with RSC, type-safe JSON-LD, Sitemap generator, and Social Preview debugger.",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.mjs"
        },
        "./preview": {
            "types": "./dist/preview.d.ts",
            "require": "./dist/preview.js",
            "import": "./dist/preview.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "bin": {
        "react-meta-seo": "dist/sitemap.js"
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run --coverage",
        "lint": "tsc --noEmit"
    },
    "keywords": [
        "react",
        "seo",
        "helmet",
        "meta",
        "head",
        "react-19",
        "rsc",
        "json-ld",
        "nextjs",
        "remix",
        "metadata",
        "open-graph",
        "schema-org",
        "sitemap",
        "twitter-card",
        "react-component",
        "seo-library",
        "react-hooks",
        "typescript",
        "react-19-ready"
    ],
    "author": "Atharva Ralegankar <ralegankaratharva@gmail.com>",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/atharva262005/react-meta.git"
    },
    "bugs": {
        "url": "https://github.com/atharva262005/react-meta/issues"
    },
    "homepage": "https://react-meta-seo.vercel.app",
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "schema-dts": "^1.1.2"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/stream-chain": "^2.1.0",
        "@types/stream-json": "^1.7.8",
        "@vitest/coverage-v8": "^1.6.1",
        "happy-dom": "^20.3.7",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "schema-dts": "^1.1.2",
        "tsup": "^8.0.1",
        "typescript": "^5.3.3",
        "vitest": "^1.2.1"
    },
    "dependencies": {
        "stream-chain": "^3.4.0",
        "stream-json": "^1.9.1"
    }
}
